# Copie para `.env` (cp .env.template .env) e troque os REPLACE_ME.
# O `.env` não vai para o git. No GitHub Actions, as mesmas duas chaves entram
# como segredos do repositório (Settings -> Secrets and variables -> Actions).

# Token do bot na Metaculus: https://www.metaculus.com/accounts/settings/bots/
METACULUS_TOKEN=REPLACE_ME

# Chave da API da Anthropic: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=REPLACE_ME

# Ajustes opcionais (os valores abaixo são os padrões).
# BOT_RESEARCH_MODEL=claude-opus-5-5
# BOT_FORECAST_MODEL=claude-opus-5-5
# BOT_RESEARCH_EFFORT=high
# BOT_FORECAST_EFFORT=high
# BOT_MAX_SEARCHES=8
# BOT_MAX_FETCHES=5
# BOT_FORECASTS_PER_QUESTION=5
# BOT_MAX_USD_PER_RUN=8
# BOT_MAX_USD_PER_DAY=15
# BOT_PARALLEL_CALLS=4
# BOT_PARALLEL_QUESTIONS=2
